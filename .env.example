APP_NAME="FROMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gct_system.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------
# GEOAPIFY AND OSRM
# ----------------------------------------------------------

GEOAPIFY_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org

# ----------------------------------------------------------
# LOCAL MYSQL / MYSQL WORKBENCH
# ----------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gct_system
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------
# DOCKER DATABASE SETTINGS
# Keep commented while using Herd or local MySQL.
# ----------------------------------------------------------

# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=gct_system
# DB_USERNAME=sail
# DB_PASSWORD=password

# MYSQL_ROOT_PASSWORD=root123
# FORWARD_DB_PORT=3307
# WWWUSER=1000
# WWWGROUP=1000

# ----------------------------------------------------------
# SESSION
# ----------------------------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false

# ----------------------------------------------------------
# BROADCASTING, STORAGE, QUEUE, CACHE
# ----------------------------------------------------------

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# CACHE_PREFIX=

# ----------------------------------------------------------
# MEMCACHED / REDIS
# ----------------------------------------------------------

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------------------
# MAIL
# ----------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------
# AWS
# ----------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------
# AUDIT LOG RETENTION
# ----------------------------------------------------------

ACTIVITY_LOG_RETENTION_DAYS=365
ACTIVITY_LOG_PRUNE_BATCH_SIZE=1000

# ----------------------------------------------------------
# VITE
# ----------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------
# PYTHON ENGINE (NLP + OPERATION AI)
# ----------------------------------------------------------

NLP_API_URL=http://127.0.0.1:8000
OPERATION_AI_BASE_URL=http://127.0.0.1:8000
OPERATION_AI_TIMEOUT=5

# ----------------------------------------------------------
# LARAVEL REVERB
# ----------------------------------------------------------

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"